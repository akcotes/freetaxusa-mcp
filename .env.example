# FreeTaxUSA MCP configuration. No secrets live here: you sign in by hand in the
# browser window, and the server never receives your password.

# Headless mode. Manual login needs a visible window, so this must be false.
FREETAXUSA_HEADLESS=false

# Tax year (default: 2025). Must be a four-digit year; anything else is rejected at startup.
# FREETAXUSA_TAX_YEAR=2025

# Browser profile directory (default: ~/.freetaxusa-mcp/browser-profile/)
# FREETAXUSA_USER_DATA_DIR=~/.freetaxusa-mcp/browser-profile/

# Chrome binary (default: first of the standard Chrome / Beta / Dev / Canary install paths found)
# FREETAXUSA_CHROME_PATH=

# Page-change timeout in ms, 5000-300000 (default: 30000)
# FREETAXUSA_NAV_TIMEOUT_MS=30000
